# Telegram API credentials юзер-аккаунта (https://my.telegram.org)
API_ID=36521688
API_HASH=f19d8985927a128d46875b0c4e3bff8c

# Управляющий бот (@BotFather)
BOT_TOKEN=8851898841:AAGDy6NBeGuTExkmaT2exP9FkyGnFhO3JSI
# Telegram user id владельца — только он может управлять ботом (@userinfobot)
OWNER_ID=1586025363


# Необязательные значения по умолчанию для первого запуска (дальше правятся через бота)
MESSAGE_TEXT=Test broadcast message
INTERVAL_MINUTES=62

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Транспорт до серверов Telegram: full | abridged | intermediate | obfuscated
# obfuscated хуже опознаётся DPI — помогает, если соединение рвётся на рукопожатии
CONNECTION_MODE=full

# Прокси (необязательно). Пустой PROXY_TYPE — подключаться напрямую.
# socks5 | socks4 | http | mtproxy
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
# Только для PROXY_TYPE=mtproxy: секрет прокси в hex
PROXY_SECRET=
