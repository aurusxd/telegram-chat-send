# Telegram API credentials юзер-аккаунта (https://my.telegram.org)
# ВАЖНО: если переносите готовую сессию из другого проекта, укажите те же
# API_ID и API_HASH, с которыми она была создана, иначе Telegram её отзовёт.
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Управляющий бот (@BotFather)
BOT_TOKEN=1234567890:AAExampleTokenExampleTokenExampleXYZ
# Telegram user id владельца — только он может управлять ботом (@userinfobot)
OWNER_ID=123456789

# Имя файла сессии Hydrogram внутри data/ (без расширения .session).
# Готовую сессию положите в data/ и укажите её имя здесь.
SESSION_NAME=session

# Необязательные значения по умолчанию для первого запуска (дальше правятся через бота)
MESSAGE_TEXT=Test broadcast message
INTERVAL_MINUTES=15

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Прокси (необязательно). Пустой PROXY_TYPE — подключаться напрямую.
# socks5 | socks4 | http
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
